# =========================
# DATABASE (PRISMA)
# =========================
# PostgreSQL connection string used by Prisma ORM
# Get this from Neon, Supabase, Railway, etc.
DATABASE_URL="postgresql://user:password@host:5432/database"

# =========================
# CHATBOT (GEMINI)
# =========================
GOOGLE_API_KEY="tu_google_gemini_api_key"
GOOGLE_API_KEY_2="tu_segunda_google_gemini_api_key"

# =========================
# RESEND
# =========================
RESEND_API_KEY="tu_resend_api_key"
FROM_EMAIL="no-reply@tudominio.com"
CONTACT_EMAIL="tu_correo_personal@tudominio.com"

# =========================
# SITE (SEO)
# =========================
# URL canónica del sitio: se usa en metadata, sitemap y OpenGraph.
# En producción apúntala a tu dominio real (sin barra final).
NEXT_PUBLIC_SITE_URL="https://tudominio.com"

# =========================
# ANALYTICS (opcional)
# =========================
# ID de Google Analytics. Si se omite, no se carga el script de GA.
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"